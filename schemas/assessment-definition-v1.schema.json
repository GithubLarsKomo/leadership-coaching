{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leadership-coaching.ratzeburg-ai.de/schemas/assessment-definition-v1.schema.json",
  "title": "Leadership Assessment Definition v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "definitionId", "version", "title", "goal", "leadershipContextRef", "scorecardRef", "sessionPolicy", "roundStrategy", "rounds"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "definitionId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "version": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "goal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["description", "desiredOutcome"],
      "properties": {
        "description": {"type": "string"},
        "desiredOutcome": {"type": "string"}
      }
    },
    "leadershipContextRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {"type": "string"},
        "version": {"type": "string"}
      }
    },
    "scorecardRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": {"type": "string"},
        "version": {"type": "string"}
      }
    },
    "sessionPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adaptive", "timed", "feedbackPolicy", "allowRetries"],
      "properties": {
        "adaptive": {"type": "boolean"},
        "timed": {"type": "boolean"},
        "feedbackPolicy": {"enum": ["none", "after-task", "after-round", "after-block", "after-session"]},
        "allowRetries": {"type": "boolean"}
      }
    },
    "roundStrategy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generationMode", "maxPrimaryCompetenciesPerRound"],
      "properties": {
        "generationMode": {"enum": ["fixed", "progressive-manual"]},
        "maxPrimaryCompetenciesPerRound": {"type": "integer", "minimum": 1, "maximum": 5}
      }
    },
    "generationPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "assessmentPrompt": {"type": "string"},
        "nextRoundPrompt": {"type": "string"}
      }
    },
    "settings": {"type": "object"},
    "rounds": {"type": "array", "minItems": 1, "items": {"$ref": "round-v1.schema.json"}}
  }
}
