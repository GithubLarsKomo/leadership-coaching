{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leadership-assessment.ratzeburg-ai.de/schemas/assessment-definition-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "definitionId", "version", "title", "goal", "scorecardRef", "rounds"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "definitionId": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "version": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "goal": {"type": "object", "required": ["description", "desiredOutcome"], "properties": {"description": {"type": "string"}, "desiredOutcome": {"type": "string"}}},
    "scorecardRef": {"type": "object", "required": ["id", "version"], "properties": {"id": {"type": "string"}, "version": {"type": "string"}}},
    "settings": {"type": "object"},
    "rounds": {"type": "array", "minItems": 1, "items": {"$ref": "round-v1.schema.json"}}
  }
}
