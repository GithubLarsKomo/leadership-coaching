{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leadership-assessment.ratzeburg-ai.de/schemas/round-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "purpose", "delivery", "competencies", "questions"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
    "title": {"type": "string", "minLength": 1},
    "purpose": {"type": "string", "minLength": 1},
    "delivery": {
      "type": "object",
      "required": ["revealOnUnlock", "allowPause"],
      "properties": {
        "revealOnUnlock": {"type": "boolean"},
        "allowPause": {"const": false},
        "timeLimitSeconds": {"type": "integer", "minimum": 30},
        "showCountdown": {"type": "boolean"}
      }
    },
    "competencies": {"type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": {"type": "string"}},
    "difficulty": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 1, "maximum": 5}},
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "type", "prompt", "required"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "type": {"enum": ["text", "textarea", "number", "single_choice", "multiple_choice", "ranking"]},
          "prompt": {"type": "string", "minLength": 1},
          "required": {"type": "boolean"},
          "options": {"type": "array"}
        }
      }
    }
  }
}
