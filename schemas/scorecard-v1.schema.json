{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://leadership-assessment.ratzeburg-ai.de/schemas/scorecard-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "scorecardId", "version", "dimensions"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "scorecardId": {"type": "string"},
    "version": {"type": "string"},
    "dimensions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label", "weight", "definition"],
        "properties": {
          "id": {"type": "string"},
          "label": {"type": "string"},
          "weight": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
          "definition": {"type": "string"},
          "observableEvidence": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
